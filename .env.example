# ── KisanSetu environment template ──────────────────────────────────────────
# Copy to .env in /server and fill in real values for production.
# The app runs fully in demo mode with none of the external keys set.

# --- Database -----------------------------------------------------------
DATABASE_URL=postgres://kisansetu:kisansetu_dev_pw@localhost:5432/kisansetu

# --- Auth -----------------------------------------------------------------
JWT_SECRET=change_this_in_production_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- SMS (optional — MockSMSProvider is used when these are unset) ---------
SMS_PROVIDER=mock
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Mandi / Price intelligence (optional — SeededPriceProvider fallback) --
MANDI_API_URL=
MANDI_API_KEY=

# --- ML forecasting service (optional — internal TS fallback used if down) -
ML_SERVICE_URL=http://localhost:8000
