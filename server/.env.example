# --- Database -----------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kisansetu

# --- Auth -----------------------------------------------------------------
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- SMS (optional — MockSMSProvider is used when these are unset) ---------
SMS_PROVIDER=mock
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Mandi / Price intelligence (optional — SeededPriceProvider fallback) --
MANDI_API_URL=
MANDI_API_KEY=

# --- ML forecasting service (optional — internal TS fallback used if down) -
ML_SERVICE_URL=http://localhost:8000

# --- Email / SMTP (optional — for real inbox delivery via Gmail or SMTP) ----
SMTP_SERVICE=gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="KisanSetu" <your_email@gmail.com>
